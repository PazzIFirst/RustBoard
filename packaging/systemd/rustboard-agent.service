# Managed by rustboard-install; do not edit.
# RustBoard Agent systemd unit（由 rustboard-install 渲染）。
[Unit]
Description=RustBoard Agent
Documentation=https://github.com/pazzifirst/rustboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rustboard-agent run --config /etc/rustboard/agent.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/var/lib/rustboard/agent

[Install]
WantedBy=multi-user.target
