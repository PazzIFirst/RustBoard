# Managed by rustboard-install; do not edit.
# RustBoard Hub systemd unit（由 rustboard-install 渲染）。
[Unit]
Description=RustBoard Hub
Documentation=https://github.com/pazzifirst/rustboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rustboard-hub run --config /etc/rustboard/hub.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/var/lib/rustboard/hub

[Install]
WantedBy=multi-user.target
